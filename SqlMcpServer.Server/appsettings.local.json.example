{
  "Database": {
    "ConnectionString": "Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "c:/logs/sql-mcp/sql-mcp.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "QueryOptions": {
    "MaxRows": 500,
    "MaxCellLength": 5000,
    "CommandTimeoutSeconds": 30
  }
}
